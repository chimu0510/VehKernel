# Environment configuration for ~/.config/systemd/user/vehkernel-bridge.service
# (ADR-0027, ADR-0028, spec 0017). Copy to ~/.config/vehkernel/bridge.env and
# uncomment the values you want to override.

# Absolute path to the colcon workspace where vehkernel_bridge was built.
# Note: systemd EnvironmentFile does not expand "~"; use an absolute path.
# VK_BRIDGE_WORKSPACE=/home/ubuntu/vk_ws

# Serial device for the board's Link. On C50C V1.1, both USB serial adapters
# collide under /dev/serial/by-id/, so prefer /dev/serial/by-path/... or a
# port-pinned udev symlink such as /dev/vehkernel-link.
# VK_BRIDGE_DEVICE=/dev/ttyACM0

# Serial baud rate matching SERIAL1_BAUD / SERIAL2_BAUD on the MCU.
# VK_BRIDGE_BAUD=921600

# Optional ROS2 domain ID (unset defaults to 0; must match any desktop RViz host).
# ROS_DOMAIN_ID=0
