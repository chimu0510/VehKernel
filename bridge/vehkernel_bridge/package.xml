<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- The Bridge node: one Link as ROS2 topics and services (ADR-0027, spec 0015). -->
<package format="3">
  <name>vehkernel_bridge</name>
  <version>0.1.0</version>
  <description>ROS2 Bridge between a Vehkernel Link and ROS2</description>
  <maintainer email="vehkernel@users.noreply.github.com">Vehkernel contributors</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>vehkernel_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
