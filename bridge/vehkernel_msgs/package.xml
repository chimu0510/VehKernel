<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- ROS2 messages and services the Bridge needs that standard packages lack (ADR-0027, spec 0015). -->
<package format="3">
  <name>vehkernel_msgs</name>
  <version>0.1.0</version>
  <description>ROS2 messages and services of the Vehkernel Bridge</description>
  <maintainer email="vehkernel@users.noreply.github.com">Vehkernel contributors</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
