# Writes HEADER with the git identity of SOURCE_DIR (ADR-0023), only when it
# changed. Without git, or outside a repository, the hash is 0 and the tree
# counts as clean. Run with cmake -DSOURCE_DIR=... -DHEADER=... -P.

set(hash 0)
set(dirty 0)
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} rev-parse --short=8 HEAD
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE commit_result ERROR_QUIET)
  if(commit_result EQUAL 0 AND commit MATCHES "^[0-9a-f]+$")
    set(hash "0x${commit}")
    # Changes to tracked files only, as git describe --dirty counts them.
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} status --porcelain --untracked-files=no
      OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT changes STREQUAL "")
      set(dirty 1)
    endif()
  endif()
endif()

if(dirty)
  set(dirty_value true)
else()
  set(dirty_value false)
endif()
set(content "// Generated by cmake/git_identity.cmake; do not edit.
#pragma once

#include <cstdint>

namespace vk::build {
inline constexpr std::uint32_t git_hash = ${hash}U;
inline constexpr bool git_dirty = ${dirty_value};
}  // namespace vk::build
")
if(EXISTS ${HEADER})
  file(READ ${HEADER} old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE ${HEADER} "${content}")
endif()
